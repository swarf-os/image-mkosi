# Test-only unit, passed to the VM as a credential by scripts/boot-test.sh.
# It never reaches the image: release images carry no VM convenience.
[Unit]
Description=swarf CI boot check
ConditionPathExists=!/etc/initrd-release
After=multi-user.target getty.target

[Service]
Type=oneshot
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/bin/bash -c '\
  echo CI-CHECK-BEGIN; \
  sed "s/^/CI-OSREL: /" /etc/os-release; \
  sed "s/^/CI-ISSUE: /" /etc/issue; \
  bootctl list --no-pager 2>&1 | sed -n "s/^ *title: */CI-BOOT-TITLE: /p"; \
  sed "s/^/CI-HOSTNAME: /" /proc/sys/kernel/hostname; \
  findmnt -n -o TARGET,SOURCE,FSTYPE / | sed "s/^/CI-MOUNT: /"; \
  findmnt -n -o TARGET,SOURCE,FSTYPE /usr | sed "s/^/CI-MOUNT: /"; \
  systemctl is-system-running | sed "s/^/CI-STATE: /"; \
  systemctl --failed --no-legend --plain | sed "s/^/CI-FAILED: /"; \
  systemctl is-active getty.target | sed "s/^/CI-GETTY: /"; \
  bootctl status --no-pager 2>/dev/null | sed -n "s/^ *Secure Boot: */CI-SECUREBOOT: /p"; \
  ls /usr/lib/verity.d 2>&1 | sed "s/^/CI-VERITY-CERT: /"; \
  journalctl -b -o cat --no-pager | grep -i -E "verity|signature|secure ?boot" | head -n 20 | sed "s/^/CI-VERITY-LOG: /"; \
  echo CI-CHECK-END'
ExecStartPost=/usr/bin/systemctl poweroff --no-block
